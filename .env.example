# ============================================================================
# THE MAKING OF ABDURRAHMAN — Environment Configuration Template
# Copy this file to .env (and frontend/.env or backend/.env as needed)
# Never commit real API keys or secrets to version control.
# ============================================================================

# --- Frontend Configuration (Vite) ---
VITE_APP_TITLE="THE MAKING OF ABDURRAHMAN"
VITE_API_BASE_URL="http://127.0.0.1:8005/api/v1"
VITE_AUREVON_EXTERNAL_URL="http://127.0.0.1:8000/api"
VITE_CV_PATH="/assets/cv/Abdurrahman-Zarook-CV.pdf"
VITE_AVATAR_MODEL_PATH="/assets/models/abdurrahman-avatar.glb"

# --- Backend Server Configuration (FastAPI) ---
APP_NAME="THE MAKING OF ABDURRAHMAN API"
APP_ENV="development"
DEBUG=true
HOST="127.0.0.1"
PORT=8005
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:5175,http://127.0.0.1:5175"

# --- Database (Supabase PostgreSQL in Production / SQLite Async in Local Dev) ---
DATABASE_URL="sqlite+aiosqlite:///./portfolio.db"
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-secret-key"

# --- Admin Security ---
SECRET_KEY="replace-with-strong-cryptographic-secret-key-in-production"
ADMIN_EMAIL="abdurrahmanzarook4455@gmail.com"
ADMIN_INITIAL_PASSWORD="change-me-immediately-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=720

# --- AUREVON AI Integration ---
# Connects to local Ollama (qwen2.5:3b) or existing AUREVON backend in development,
# or OpenAI-compatible cloud endpoint (Groq / OpenAI / DeepSeek) in hosted production.
AUREVON_BACKEND_URL="http://127.0.0.1:8000/api"
OLLAMA_BASE_URL="http://127.0.0.1:11434"
DEFAULT_AI_MODEL="qwen2.5:3b"
CLOUD_AI_PROVIDER=""
CLOUD_AI_API_KEY=""
CLOUD_AI_MODEL="llama-3.3-70b-versatile"

# --- Email Delivery Provider (SMTP / Resend) ---
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL="abdurrahmanzarook4455@gmail.com"
CONTACT_RECIPIENT_EMAIL="abdurrahmanzarook4455@gmail.com"
